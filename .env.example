# RateHawk (ETG) API
ETG_BASE_URL=https://api-sandbox.ratehawk.com
ETG_KEY_ID=
ETG_API_KEY=
# "fixture" serves recorded responses and needs no ETG credentials; "live" calls the API
ETG_MODE=fixture
# Production builds refuse fixture mode (it replays recorded prices); set to 1 only for CI and test servers
# ALLOW_FIXTURE_MODE=1

# Supabase (server-side only). Required only when ETG_MODE=live; leave blank for fixture mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
